// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}


enum WorkingPermitStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}
enum RequestLevel {
  LEVEL_1
  LEVEL_2
}

model User {
  id       Int     @id @default(autoincrement()) @map("user_id")
  name     String  @db.VarChar(150)
  username String  @unique @db.VarChar(100)
  email    String? @unique @db.VarChar(191)
  password String  @db.VarChar(255)

  isActive Boolean @default(true) @map("is_active")

  roles UserRole[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Role {
  id          Int     @id @default(autoincrement()) @map("role_id")
  name        String  @unique @map("role_name") @db.VarChar(100)
  description String? @db.Text

  users UserRole[]

  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Permission {
  id          Int              @id @default(autoincrement()) @map("permission_id")
  code        String           @unique
  name        String           @unique @db.VarChar(100)
  description String?          @db.Text
  roles       RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}


model WorkingPermit {
  id               String     @id @default(uuid()) @db.VarChar(36)
  referenceNumber  String     @unique @map("reference_number") @db.VarChar(30)
 // requestTo        String     @map("request_to") @db.VarChar(100)

  fromId Int @map("from_id")
  branchDepartmentId Int @map("branch_dep_id")
  requestToId Int @map("requestTo")

  requestLevel RequestLevel   @map("request_level") 
  date             DateTime   @db.Date
  requestFor       String     @map("request_for") @db.Text
  //branchDepartment String     @map("branch_department") @db.VarChar(150)
  requestedBy      String     @map("requested_by") @db.VarChar(100)
  checkedBy        String?    @map("checked_by") @db.VarChar(100)
  attachment       String?    @db.VarChar(500)

  status WorkingPermitStatus  @default(PENDING)

  fromDepartment DepartmentBranches @relation("WorkingPermitFrom",fields: [fromId],references: [id])
  branchDepartment DepartmentBranches @relation("WorkingPermitBranch",fields: [branchDepartmentId],references: [id])
  WorkerList WorkerList @relation(fields: [requestToId],references: [id])

  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@index([requestToId])
  @@index([date])
  @@index([fromId])

  @@map("working_permit")
}

model ReferenceCounter {
  name      String @id @db.VarChar(50)
  lastValue Int    @map("last_value")

  @@map("reference_counters")
}


model DepartmentBranches{
  id          Int     @id @default(autoincrement()) @map("id")
  entity_name             String     @db.VarChar(100)
  workingPermitsFrom WorkingPermit[] @relation("WorkingPermitFrom")
  workingPermitsBranch WorkingPermit[] @relation("WorkingPermitBranch")

  checkerId Int? @map("checker_id")
  CheckerList CheckerList? @relation("DepartmentBranch",fields: [checkerId],references: [id])

  isBranch Boolean @default(true)
  
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime?   @updatedAt @map("updated_at")
  @@map("department_branches")
}



model CheckerList {
  id          Int     @id @default(autoincrement()) @map("id")
  name String         @db.VarChar(100)

  departmentBranch DepartmentBranches[] @relation("DepartmentBranch")

  createdAt        DateTime   @default(now()) @map("created_at")

  @@map("checker_list")
}

model WorkerList{
    id          Int               @id @default(autoincrement()) @map("id")
    worker_name String            @db.VarChar(100)
    approved_by String            @db.VarChar(100)
    final_approved_by String      @db.VarChar(100)

    WorkingPermitWorker           WorkingPermit[] @relation()

    createdAt    DateTime         @default(now()) @map("created_at")

    @@map("worker_list")
}