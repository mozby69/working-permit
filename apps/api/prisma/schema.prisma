// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}


enum WorkingPermitStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
  IN_PROGRESS
}
enum RequestLevel {
  LEVEL_1
  LEVEL_2
}


model User {
  id       Int     @id @default(autoincrement()) @map("user_id")
  name     String  @db.VarChar(150)
  username String  @unique @db.VarChar(100)
  email    String? @unique @db.VarChar(191)
  password String  @db.VarChar(255)

  isActive Boolean @default(true) @map("is_active")

  roles UserRole[]
  departmentBranches DepartmentBranches[] @relation("DepartmentChecker")
  firstApproverAssignments WorkerList[] @relation("FirstApprover")
  finalApproverAssignments WorkerList[] @relation("FinalApprover")
  createdWorkingPermits WorkingPermit[] @relation("WorkingPermitCreator")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Role {
  id          Int     @id @default(autoincrement()) @map("role_id")
  name        String  @unique @map("role_name") @db.VarChar(100)
  description String? @db.Text

  users UserRole[]

  

  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Permission {
  id          Int              @id @default(autoincrement()) @map("permission_id")
  code        String           @unique
  name        String           @unique @db.VarChar(100)
  description String?          @db.Text
  roles       RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}


model WorkingPermit {
  id               String     @id @default(uuid()) @db.VarChar(36)
  referenceNumber  String     @unique @map("reference_number") @db.VarChar(30)
  requestLevel RequestLevel   @map("request_level") 
  date             DateTime   @db.Date
  requestFor       String     @map("request_for") @db.Text
  requestedBy      String     @map("requested_by") @db.VarChar(100)
  checkedBy        String?    @map("checked_by") @db.VarChar(100)
  attachment       String?    @db.VarChar(500)

  sequence         Int        @default(1)

  fromId Int @map("from_id")
  fromDepartment DepartmentBranches @relation("WorkingPermitFrom",fields: [fromId],references: [id])

  branchDepartmentId Int @map("branch_dep_id")
  branchDepartment DepartmentBranches @relation("WorkingPermitBranch",fields: [branchDepartmentId],references: [id])

  requestToId Int @map("requestTo")
  WorkerList WorkerList @relation(fields: [requestToId],references: [id])

  createdById Int @map("created_by_id")
  createdBy User @relation("WorkingPermitCreator",fields: [createdById],references: [id])

  ApprovalTable           ApprovalTable[] @relation()
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@index([requestToId])
  @@index([date])
  @@index([fromId])
  @@index([createdById])

  @@map("working_permit")
}

model ReferenceCounter {
  name      String @id @db.VarChar(50)
  lastValue Int    @map("last_value")

  @@map("reference_counters")
}


model DepartmentBranches {
  id          Int     @id @default(autoincrement()) @map("id")
  entityName             String     @map("entity_name") @db.VarChar(100)
  workingPermitsFrom WorkingPermit[] @relation("WorkingPermitFrom")
  workingPermitsBranch WorkingPermit[] @relation("WorkingPermitBranch")

  checkerId Int? @map("checker_id")

  checker User? @relation("DepartmentChecker",fields: [checkerId],references: [id],onDelete: SetNull)


  isBranch Boolean @default(true)
  
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime?   @updatedAt @map("updated_at")
  @@map("department_branches")
}




model WorkerList{
    id          Int               @id @default(autoincrement()) @map("id")
    worker_name String            @db.VarChar(100)
    firstApproverUserId Int? @map("first_approver_user_id")
    finalApproverUserId Int? @map("final_approver_user_id")
    firstApproverUser User? @relation("FirstApprover", fields: [firstApproverUserId], references: [id])
    finalApproverUser User? @relation("FinalApprover",fields: [finalApproverUserId],references: [id])

    WorkingPermitWorker           WorkingPermit[] @relation()

    createdAt    DateTime         @default(now()) @map("created_at")

    @@map("worker_list")
}



model ApprovalTable {
  id               String     @id @default(uuid()) @db.VarChar(36)
  indexNum Int    @unique @default(autoincrement()) @map("index_num")

  workingPermitId String @map("working_permit_id") @db.VarChar(36)
  workingPermit WorkingPermit @relation(fields: [workingPermitId],references: [id], onDelete: Cascade)


  status WorkingPermitStatus  @default(PENDING)
  checkedStatus  WorkingPermitStatus @default(PENDING)  @map("checked_status")
  firstApproverStatus  WorkingPermitStatus@default(PENDING) @map("approver_first_status")
  finalApproverStatus WorkingPermitStatus  @default(PENDING) @map("approver_final_status")

  statusAt                  DateTime? @map("status_at")
  checkedStatusAt           DateTime? @map("checked_status_at")
  firstApproverApprovedAt   DateTime? @map("first_approver_approved_at")
  finalApproverApprovedAt   DateTime? @map("final_approver_approved_at")


  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime?   @updatedAt @map("updated_at")



  @@map("approval_table")
}

